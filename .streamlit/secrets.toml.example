# Copy this file to .streamlit/secrets.toml and replace the placeholder.
# secrets.toml is ignored by Git and must never be committed.
# Select one provider. If omitted, the first configured key is selected.
LLM_PROVIDER = "openai" # openai, deepseek, or qwen
# Optional request timeout in seconds. DeepSeek/Qwen default to 90; OpenAI defaults to 30.
# LLM_TIMEOUT = "90"

# OpenAI
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4.1-mini"
OPENAI_BASE_URL = "https://api.openai.com/v1"

# DeepSeek
DEEPSEEK_API_KEY = ""
DEEPSEEK_MODEL = "deepseek-chat"
DEEPSEEK_BASE_URL = "https://api.deepseek.com/v1"

# Qwen / DashScope
QWEN_API_KEY = ""
QWEN_MODEL = "qwen-plus"
QWEN_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
